# Supabase Dashboard > Connect 에서 복사합니다.
# 서비스 역할 키(secret/service_role)는 브라우저 환경 변수에 넣지 않습니다.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# 로컬에서 관리자 초기 비밀번호를 설정할 때만 임시로 사용합니다.
# Secret key 및 설정 코드는 절대 NEXT_PUBLIC_ 접두사를 붙이거나 Git에 커밋하지 마세요.
SUPABASE_SECRET_KEY=
RECPLUS_INITIAL_PASSWORD_SETUP_ENABLED=false
RECPLUS_INITIAL_PASSWORD_SETUP_TOKEN=
# 예: 2026-09-03T12:00:00+09:00 (만료 후에는 설정 화면이 작동하지 않습니다.)
RECPLUS_INITIAL_PASSWORD_SETUP_EXPIRES_AT=
